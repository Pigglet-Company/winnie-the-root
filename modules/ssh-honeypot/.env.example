# Módulo A (Cowrie + OpenCanary). Copia a .env y ajusta. No contiene secretos.
# Dirección donde se publican 2222/2223/2121/3307/6380. 127.0.0.1 = solo esta máquina.
# 0.0.0.0 los abre en todas las interfaces (deploy/setup.sh lo fija así en el VPS).
HP_BIND_ADDR=127.0.0.1
COWRIE_CPUS=1.0
COWRIE_MEM_LIMIT=512m
CANARY_CPUS=0.5
CANARY_MEM_LIMIT=256m
