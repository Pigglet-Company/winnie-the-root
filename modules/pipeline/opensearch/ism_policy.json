{
  "policy": {
    "description": "Retencion de eventos honeypot: borra el indice tras __RETENTION_DAYS__ dias",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          { "state_name": "delete", "conditions": { "min_index_age": "__RETENTION_DAYS__d" } }
        ]
      },
      {
        "name": "delete",
        "actions": [ { "delete": {} } ],
        "transitions": []
      }
    ],
    "ism_template": [
      { "index_patterns": ["honeypot-events-*"], "priority": 100 }
    ]
  }
}
