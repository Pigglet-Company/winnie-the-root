{
  "index_patterns": ["honeypot-events-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "index.mapping.total_fields.limit": 2000
    },
    "aliases": { "honeypot-events": {} },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp":      { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "event_id":        { "type": "keyword" },
        "honeypot":        { "type": "keyword" },
        "service":         { "type": "keyword" },
        "event_type":      { "type": "keyword" },
        "src_ip":          { "type": "ip" },
        "src_port":        { "type": "integer" },
        "dst_port":        { "type": "integer" },
        "session_id":      { "type": "keyword" },
        "auth": {
          "properties": {
            "username": { "type": "keyword", "ignore_above": 256 },
            "password": { "type": "keyword", "ignore_above": 256 },
            "success":  { "type": "boolean" }
          }
        },
        "command": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "http": {
          "properties": {
            "method":     { "type": "keyword" },
            "path":       { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
            "query":      { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
            "headers":    { "type": "object", "enabled": false },
            "body":       { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
            "user_agent": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
            "status":     { "type": "integer" }
          }
        },
        "file": {
          "properties": {
            "name":   { "type": "keyword", "ignore_above": 512 },
            "sha256": { "type": "keyword" },
            "size":   { "type": "long" },
            "url":    { "type": "keyword", "ignore_above": 2048 }
          }
        },
        "duration_s": { "type": "float" },
        "raw":        { "type": "object", "enabled": false },
        "geo": {
          "properties": {
            "country_iso":  { "type": "keyword" },
            "country_name": { "type": "keyword" },
            "city":         { "type": "keyword" },
            "location":     { "type": "geo_point" }
          }
        },
        "attack_type":     { "type": "keyword" },
        "mitre_technique": { "type": "keyword" },
        "mitre_tactic":    { "type": "keyword" }
      }
    }
  }
}
