# Módulo C (Vector + OpenSearch + Dashboards). Copia a .env y ajusta.
# dev = sin TLS ni autenticación (solo laboratorio local). prod = TLS + usuario admin.
SECURITY_MODE=dev
# Obligatoria con SECURITY_MODE=prod: elige una contraseña robusta. Nunca la subas a Git.
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_HEAP=1g
RETENTION_DAYS=30
# Opcional: clave de MaxMind para GeoIP (scripts/download_geolite.sh). Vacía = sin campo geo.
MAXMIND_LICENSE_KEY=
