# Módulo B (intranet web simulada). Copia a .env y ajusta. No contiene secretos.
# Todas las variables: app/config.py y docs/modules/web-honeypot/guide.md.
# Dirección y puerto publicados en el host. 127.0.0.1 = solo esta máquina.
HP_BIND_ADDR=127.0.0.1
WEB_HOST_PORT=8080
# Credencial débil que "entra" al panel falso. WEAK_PASS vacío = login siempre rechazado.
WEAK_USER=admin
WEAK_PASS=
# true solo detrás de un proxy propio: toma la IP del último X-Forwarded-For.
TRUST_PROXY=false
# true = /comment refleja el XSS sin escapar (solo laboratorio).
COMMENT_REFLECT_RAW=false
COMMENT_CSP=
